{
  "name": "coep-venue-booking",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun run --cwd backend dev\" \"bun run --cwd frontend dev\"",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "db:init": "bun run --cwd backend db:init",
    "db:reset": "bun run --cwd backend db:reset",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
