{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bun:dev": "bun --hot src/index.ts",
    "bun:build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify",
    "bun:start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
